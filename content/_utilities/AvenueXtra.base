filters:
  and:
    - "!img.isEmpty()"
views:
  - type: table
    name: Table
    filters:
      and:
        - note["WWM Player"] == true
    order:
      - file.name
      - Timezone (UTC)
      - GameID
      - aliases
      - Alt
      - Masked Troupe name
      - Path - main
      - Path - secondary
      - Path - Former
      - Role
      - Sect
      - Sect - Former
      - Guild Role
      - GVG Team
      - GVG Role
      - GVG Title
      - Cohort
      - Cohort Rank
      - Master
      - Disciple Rank
      - Disciple
      - Partner
      - Partner - Former
      - External
      - Ext Description
      - img
      - cover
