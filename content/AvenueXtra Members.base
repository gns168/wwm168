views:
  - type: table
    name: Table
    filters:
      and:
        - note["WWM Player"] == true
    order:
      - file.name
      - Timezone (UTC)
      - GameID
      - steam
      - homestead
      - aliases
      - Alt
      - Masked Troupe name
      - Path - main
      - Path - secondary
      - Path - Former
      - Role
      - Sect
      - Sect - Former
      - Guild Role
      - GVG Team
      - GVG Role
      - GVG Title
      - Cohort
      - Cohort Rank
      - Master
      - Disciple Rank
      - Disciple
      - Partner
      - Partner - Former
      - External
      - Ext Description
      - img
      - cover
      - WWM Player
    sort:
      - property: Timezone (UTC)
        direction: ASC
      - property: GVG Team
        direction: ASC
      - property: Sect
        direction: ASC
      - property: Path - main
        direction: ASC
      - property: img
        direction: ASC
      - property: Guild Member
        direction: DESC
    columnSize:
      note.Masked Troupe name: 96
      note.Path - main: 172
      note.Path - secondary: 176
      note.Path - Former: 140
