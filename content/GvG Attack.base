views:
  - type: cards
    name: Table
    filters:
      and:
        - note["GVG Team"] == link("_Attack")
    groupBy:
      property: GVG Team
      direction: DESC
    order:
      - file.name
      - GVG Role
      - Path - main
      - Path - secondary
    sort:
      - property: GVG Role
        direction: ASC
      - property: file.name
        direction: ASC
      - property: GVG Team
        direction: ASC
    columnSize: {}
    image: note.img
    imageFit: contain
    cardSize: 160
